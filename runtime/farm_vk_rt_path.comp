#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x = 8, local_size_y = 8) in;

const float RAY_EPS = 1e-4;
const float T_MIN = 1e-6;
const float DET_EPS = 1e-12;
const float NDOT_EPS = 1e-8;
const float FARM_PI = 3.141592653589793;

layout(std430, binding = 0) buffer ParamBuf {
  ivec4 size;      // width, height, samples, start_s
  ivec4 counts;    // max_bounces, ntri, nmat, namb
  ivec4 counts2;   // ndir, npt, nrect, ntexels
  ivec4 flags;     // roulette, sampling, adaptive, nnodes
  vec4 background; // rgb, fov_deg
  vec4 cam_pos;    // xyz, aspect
  vec4 cam_x;
  vec4 cam_y;
  vec4 cam_z;
  vec4 extra;      // adaptive_target, bvh_root, glossy, 0
} P;

struct GpuTri {
  vec4 v0;   // xyz, matId
  vec4 v1;   // xyz, meshIndex
  vec4 v2;   // xyz, triIndex
  vec4 uv01; // u0 v0 u1 v1
  vec4 uv2;  // u2 v2 pad pad
};

layout(std430, binding = 1) buffer TriBuf { GpuTri tris[]; };
layout(std430, binding = 2) buffer MatBuf {
  vec4 mats[]; // 4 vec4 per material
};
layout(std430, binding = 3) buffer LightBuf { vec4 lights[]; };
layout(std430, binding = 4) buffer TexBuf { float texels[]; };
layout(std430, binding = 5) buffer AccumBuf { float accum[]; };

layout(binding = 6) uniform accelerationStructureEXT tlas;

uint mix32(uint a, uint b) {
  uint x = a * 1664525u + b + 1013904223u;
  x ^= x >> 16;
  x *= 0x7feb352du;
  x ^= x >> 15;
  x *= 0x846ca68bu;
  x ^= x >> 16;
  return x;
}

float rand01(int px, int py, int s, int dim) {
  uint h = mix32(mix32(mix32(uint(px), uint(py)), uint(s)), uint(dim));
  return (float(h) + 0.5) * (1.0 / 4294967296.0);
}

float radical_inverse(uint n, uint base) {
  float inv = 0.0, f = 1.0 / float(base);
  while (n > 0u) {
    inv += float(n % base) * f;
    n /= base;
    f /= float(base);
  }
  return inv;
}

void pixel_jitter(int s, out float jx, out float jy) {
  if (s == 0) { jx = 0.5; jy = 0.5; return; }
  jx = radical_inverse(uint(s), 2u);
  jy = radical_inverse(uint(s), 3u);
}

float clamp01(float x) { return clamp(x, 0.0, 1.0); }

vec3 xform_point(vec4 r0, vec4 r1, vec4 r2, vec4 r3, vec3 v) {
  // matrixWorld column-major elements: r0.xyzw = e0..e3, etc. matching C e[0]+e[4]+e[8]+e[12]
  return vec3(
    r0.x * v.x + r1.x * v.y + r2.x * v.z + r3.x,
    r0.y * v.x + r1.y * v.y + r2.y * v.z + r3.y,
    r0.z * v.x + r1.z * v.y + r2.z * v.z + r3.z);
}

vec3 xform_dir(vec4 r0, vec4 r1, vec4 r2, vec3 v) {
  return vec3(
    r0.x * v.x + r1.x * v.y + r2.x * v.z,
    r0.y * v.x + r1.y * v.y + r2.y * v.z,
    r0.z * v.x + r1.z * v.y + r2.z * v.z);
}

bool intersect_tri(vec3 o, vec3 d, vec3 a, vec3 b, vec3 c, out float t, out float u, out float v) {
  vec3 e1 = b - a, e2 = c - a;
  vec3 pvec = cross(d, e2);
  float det = dot(e1, pvec);
  if (det > -DET_EPS && det < DET_EPS) return false;
  float inv = 1.0 / det;
  vec3 tvec = o - a;
  float uu = dot(tvec, pvec) * inv;
  if (uu < 0.0 || uu > 1.0) return false;
  vec3 qvec = cross(tvec, e1);
  float vv = dot(d, qvec) * inv;
  if (vv < 0.0 || uu + vv > 1.0) return false;
  float tt = dot(e2, qvec) * inv;
  if (tt <= T_MIN) return false;
  t = tt; u = uu; v = vv;
  return true;
}

bool better_hit(float t, int mesh, int tri, bool had, float bt, int bm, int btr) {
  if (!had) return true;
  if (t < bt) return true;
  if (t == bt && (mesh < bm || (mesh == bm && tri < btr))) return true;
  return false;
}

struct Hit {
  bool hit;
  float t, u, v;
  int mesh_index, tri_index, mat_id, tri_i;
};

Hit closest_hit(vec3 o, vec3 d) {
  Hit best;
  best.hit = false;
  best.t = 1e30;
  best.u = 0.0; best.v = 0.0;
  best.mesh_index = 0; best.tri_index = 0; best.mat_id = 0; best.tri_i = 0;
  int ntri = P.counts.y;
  if (ntri <= 0) return best;
  rayQueryEXT rq;
  rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFFu, o, T_MIN, d, 1e30);
  while (rayQueryProceedEXT(rq)) {
    rayQueryConfirmIntersectionEXT(rq);
  }
  if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionTriangleEXT)
    return best;
  best.hit = true;
  best.t = rayQueryGetIntersectionTEXT(rq, true);
  vec2 bary = rayQueryGetIntersectionBarycentricsEXT(rq, true);
  best.u = bary.x;
  best.v = bary.y;
  int prim = int(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
  if (prim < 0 || prim >= ntri) { best.hit = false; return best; }
  GpuTri tr = tris[prim];
  best.mesh_index = int(tr.v1.w);
  best.tri_index = int(tr.v2.w);
  best.mat_id = int(tr.v0.w);
  best.tri_i = prim;
  return best;
}

bool any_hit(vec3 o, vec3 d, float t_max) {
  if (t_max <= T_MIN) return false;
  int ntri = P.counts.y;
  if (ntri <= 0) return false;
  rayQueryEXT rq;
  uint flags = gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT | gl_RayFlagsSkipClosestHitShaderEXT;
  rayQueryInitializeEXT(rq, tlas, flags, 0xFFu, o, T_MIN, d, t_max);
  rayQueryProceedEXT(rq);
  return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

vec3 schlick(vec3 f0, float cos_theta) {
  cos_theta = clamp01(cos_theta);
  float c = 1.0 - cos_theta;
  float c2 = c * c;
  float c5 = c2 * c2 * c;
  return f0 + (vec3(1.0) - f0) * c5;
}

vec3 f0_of(vec3 albedo, float metal) {
  return vec3(0.04) * (1.0 - metal) + albedo * metal;
}

float ggx_d(float ndoth, float a2) {
  float d = ndoth * ndoth * (a2 - 1.0) + 1.0;
  return a2 / (FARM_PI * d * d);
}

float smith_g1(float cos_theta, float alpha) {
  if (cos_theta <= NDOT_EPS) return 0.0;
  float cos2 = cos_theta * cos_theta;
  float tan2 = (1.0 - cos2) / cos2;
  return 2.0 / (1.0 + sqrt(1.0 + alpha * alpha * tan2));
}

float fresnel_dielectric(float cos_i, float eta_i, float eta_t) {
  float sin_t = (eta_i / eta_t) * sqrt(max(0.0, 1.0 - cos_i * cos_i));
  if (sin_t >= 1.0) return 1.0;
  float cos_t = sqrt(max(0.0, 1.0 - sin_t * sin_t));
  float r_parl = (eta_t * cos_i - eta_i * cos_t) / (eta_t * cos_i + eta_i * cos_t);
  float r_perp = (eta_i * cos_i - eta_t * cos_t) / (eta_i * cos_i + eta_t * cos_t);
  return 0.5 * (r_parl * r_parl + r_perp * r_perp);
}

vec3 reflect_dir(vec3 d, vec3 n) {
  float nd = dot(d, n);
  return normalize(d - 2.0 * nd * n);
}

bool refract_dir(vec3 d, vec3 n, float eta, float cos_i, out vec3 outd) {
  float sin2_t = eta * eta * (1.0 - cos_i * cos_i);
  if (sin2_t > 1.0) return false;
  float cos_t = sqrt(1.0 - sin2_t);
  float s = eta * cos_i - cos_t;
  outd = normalize(eta * d + s * n);
  return true;
}

void onb(vec3 n, out vec3 T, out vec3 B) {
  if (abs(n.x) > abs(n.y)) {
    float inv = 1.0 / sqrt(n.x * n.x + n.z * n.z);
    T = vec3(-n.z * inv, 0.0, n.x * inv);
  } else {
    float inv = 1.0 / sqrt(n.y * n.y + n.z * n.z);
    T = vec3(0.0, n.z * inv, -n.y * inv);
  }
  B = cross(n, T);
}

vec3 cosine_sample(float u1, float u2) {
  float r = sqrt(u1);
  float phi = 2.0 * FARM_PI * u2;
  return vec3(r * cos(phi), r * sin(phi), sqrt(max(0.0, 1.0 - u1)));
}

int glossy_on() { return P.extra.z > 0.5 ? 1 : 0; }

/* Heitz 2018 VNDF-GGX. Ve in shading frame (z = N). */
vec3 sample_vndf_ggx(vec3 Ve, float alpha, float u1, float u2) {
  vec3 Vh = normalize(vec3(alpha * Ve.x, alpha * Ve.y, Ve.z));
  float lensq = Vh.x * Vh.x + Vh.y * Vh.y;
  vec3 T1 = lensq > 0.0 ? vec3(-Vh.y, Vh.x, 0.0) * inversesqrt(lensq) : vec3(1.0, 0.0, 0.0);
  vec3 T2 = cross(Vh, T1);
  float r = sqrt(u1);
  float phi = 2.0 * FARM_PI * u2;
  float t1 = r * cos(phi);
  float t2 = r * sin(phi);
  float s = 0.5 * (1.0 + Vh.z);
  t2 = (1.0 - s) * sqrt(max(0.0, 1.0 - t1 * t1)) + s * t2;
  vec3 Nh = t1 * T1 + t2 * T2 + sqrt(max(0.0, 1.0 - t1 * t1 - t2 * t2)) * Vh;
  return normalize(vec3(alpha * Nh.x, alpha * Nh.y, max(0.0, Nh.z)));
}

float ggx_vndf_pdf(vec3 n, vec3 view, vec3 ldir, float rough) {
  float ndotl = dot(n, ldir);
  float ndotv = dot(n, view);
  if (ndotl <= 0.0 || ndotv <= NDOT_EPS) return 0.0;
  vec3 h = normalize(view + ldir);
  float ndoth = dot(n, h);
  if (ndoth <= 0.0) return 0.0;
  float alpha = rough * rough;
  float D = ggx_d(ndoth, alpha * alpha);
  float pdf = D * smith_g1(ndotv, alpha) / (4.0 * ndotv);
  if (!(pdf > 0.0)) return 0.0;
  return pdf;
}

vec3 sample_bilinear(int tw, int th, int off, float u, float v) {
  u = clamp01(u); v = clamp01(v);
  float x = u * float(tw - 1);
  float y = (1.0 - v) * float(th - 1);
  int x0 = int(floor(x)), y0 = int(floor(y));
  float tx, ty;
  if (x0 >= tw - 1) { x0 = tw - 1; tx = 0.0; } else tx = x - float(x0);
  if (y0 >= th - 1) { y0 = th - 1; ty = 0.0; } else ty = y - float(y0);
  int x1 = (x0 >= tw - 1) ? x0 : x0 + 1;
  int y1 = (y0 >= th - 1) ? y0 : y0 + 1;
  int i00 = off + (y0 * tw + x0) * 3;
  int i10 = off + (y0 * tw + x1) * 3;
  int i01 = off + (y1 * tw + x0) * 3;
  int i11 = off + (y1 * tw + x1) * 3;
  vec3 c00 = vec3(texels[i00], texels[i00 + 1], texels[i00 + 2]);
  vec3 c10 = vec3(texels[i10], texels[i10 + 1], texels[i10 + 2]);
  vec3 c01 = vec3(texels[i01], texels[i01 + 1], texels[i01 + 2]);
  vec3 c11 = vec3(texels[i11], texels[i11 + 1], texels[i11 + 2]);
  return mix(mix(c00, c10, tx), mix(c01, c11, tx), ty);
}

vec3 albedo_at(int mat_id, GpuTri tr, float u, float v) {
  vec4 color = mats[mat_id * 4 + 0];
  vec4 map = mats[mat_id * 4 + 3];
  vec3 col = color.xyz;
  if (map.x < 0.5) return col;
  float w = 1.0 - u - v;
  float uu = w * tr.uv01.x + u * tr.uv01.z + v * tr.uv2.x;
  float vv = w * tr.uv01.y + u * tr.uv01.w + v * tr.uv2.y;
  return col * sample_bilinear(int(map.y), int(map.z), int(map.w), uu, vv);
}

vec3 direct_one(vec3 acc, vec3 n, vec3 view, vec3 albedo, float metal, float trans, float rough,
                vec3 ldir, vec3 le, float scale, float vis, float mis_d) {
  if (vis == 0.0 || scale == 0.0) return acc;
  float ndotl = dot(n, ldir);
  if (ndotl <= 0.0) return acc;
  float ndotv = max(dot(n, view), 0.0);
  vec3 h = normalize(view + ldir);
  float ndoth = dot(n, h);
  float vdoth = max(dot(view, h), 0.0);
  vec3 f = schlick(f0_of(albedo, metal), vdoth);
  vec3 kd = (vec3(1.0) - f) * (1.0 - metal) * (1.0 - trans) * albedo / FARM_PI;
  acc += kd * ndotl * le * scale * mis_d;
  if (rough > 0.0 && ndotv > NDOT_EPS && ndoth > 0.0) {
    float alpha = rough * rough;
    float a2 = alpha * alpha;
    float D = ggx_d(ndoth, a2);
    float G = smith_g1(ndotv, alpha) * smith_g1(ndotl, alpha);
    float s = D * G / (4.0 * ndotv) * scale;
    acc += f * s * le;
  }
  return acc;
}

mat4 rect_mw(vec4 r0, vec4 r1, vec4 r2, vec4 r3) {
  return mat4(r0, r1, r2, r3);
}

bool sample_rect(vec4 r0, vec4 r1, vec4 r2, vec4 r3, float width, float height,
                 vec3 p, float u, float v, int improved,
                 out vec3 sample_pos, out vec3 ldir, out float dist, out float cos_light, out float pdf_area) {
  float area = width * height;
  if (area <= 0.0) return false;
  float lx, ly;
  pdf_area = 1.0 / area;
  if (improved != 0) {
    mat4 inv = inverse(rect_mw(r0, r1, r2, r3));
    vec3 lp = (inv * vec4(p, 1.0)).xyz;
    float halfw = 0.5 * width, halfh = 0.5 * height;
    float z = lp.z;
    float az = abs(z);
    if (az >= 1e-8) {
      float dx0 = -halfw - lp.x, dx1 = halfw - lp.x;
      float dy0 = -halfh - lp.y, dy1 = halfh - lp.y;
      float ax0 = atan(dx0, az), ax1 = atan(dx1, az);
      float ay0 = atan(dy0, az), ay1 = atan(dy1, az);
      float dax = ax1 - ax0, day = ay1 - ay0;
      if (abs(dax) >= 1e-12 && abs(day) >= 1e-12) {
        float tx = ax0 + u * dax;
        float ty = ay0 + v * day;
        lx = lp.x + az * tan(tx);
        ly = lp.y + az * tan(ty);
        lx = clamp(lx, -halfw, halfw);
        ly = clamp(ly, -halfh, halfh);
        float denx = z * z + (lx - lp.x) * (lx - lp.x);
        float deny = z * z + (ly - lp.y) * (ly - lp.y);
        pdf_area = (az / (abs(dax) * denx)) * (az / (abs(day) * deny));
        if (!(pdf_area > 0.0)) pdf_area = 1.0 / area;
      } else {
        lx = (u - 0.5) * width;
        ly = (v - 0.5) * height;
      }
    } else {
      lx = (u - 0.5) * width;
      ly = (v - 0.5) * height;
    }
  } else {
    lx = (u - 0.5) * width;
    ly = (v - 0.5) * height;
  }
  sample_pos = xform_point(r0, r1, r2, r3, vec3(lx, ly, 0.0));
  vec3 lvec = sample_pos - p;
  float dist2 = dot(lvec, lvec);
  if (dist2 == 0.0) return false;
  dist = sqrt(dist2);
  ldir = lvec / dist;
  vec3 nw = normalize(xform_dir(r0, r1, r2, vec3(0.0, 0.0, -1.0)));
  cos_light = dot(nw, -ldir);
  if (cos_light <= 0.0) return false;
  return true;
}

int amb_off() { return 0; }
int dir_off() { return P.counts.w; }
int pt_off() { return P.counts.w + P.counts2.x * 2; }
int rect_off() { return P.counts.w + P.counts2.x * 2 + P.counts2.y * 2; }

bool intersect_rect_ray(vec4 r0, vec4 r1, vec4 r2, vec4 r3, float width, float height,
                        vec3 o, vec3 d, float t_max, out float t_hit, out vec3 n_out) {
  if (width <= 0.0 || height <= 0.0) return false;
  mat4 inv = inverse(rect_mw(r0, r1, r2, r3));
  vec3 ol = (inv * vec4(o, 1.0)).xyz;
  vec3 dl = mat3(inv) * d;
  if (abs(dl.z) < 1e-12) return false;
  float t = -ol.z / dl.z;
  if (t <= T_MIN || t >= t_max) return false;
  float lx = ol.x + t * dl.x;
  float ly = ol.y + t * dl.y;
  if (lx < -0.5 * width || lx > 0.5 * width || ly < -0.5 * height || ly > 0.5 * height) return false;
  t_hit = t;
  n_out = normalize(xform_dir(r0, r1, r2, vec3(0.0, 0.0, -1.0)));
  return true;
}

vec3 mis_rects_along(vec3 o, vec3 d, float t_max, float pdf_bsdf, vec3 throughput) {
  if (!(pdf_bsdf > 0.0)) return vec3(0.0);
  int best = -1;
  float best_t = t_max;
  vec3 best_n = vec3(0.0);
  int nrect = P.counts2.z;
  int base_r = rect_off();
  for (int k = 0; k < nrect; k++) {
    int off = base_r + k * 6;
    vec4 r0 = lights[off + 0], r1 = lights[off + 1], r2 = lights[off + 2], r3 = lights[off + 3];
    float width = lights[off + 4].w;
    float height = lights[off + 5].x;
    float t;
    vec3 nn;
    if (intersect_rect_ray(r0, r1, r2, r3, width, height, o, d, best_t, t, nn)) {
      best = k;
      best_t = t;
      best_n = nn;
    }
  }
  if (best < 0) return vec3(0.0);
  int off = base_r + best * 6;
  vec3 le = lights[off + 4].xyz;
  float width = lights[off + 4].w;
  float height = lights[off + 5].x;
  float area = width * height;
  if (area <= 0.0) return vec3(0.0);
  float dist = best_t;
  float cos_light = dot(best_n, -d);
  if (cos_light <= 0.0) return vec3(0.0);
  float pdf_area = 1.0 / area;
  float pdf_light = pdf_area * dist * dist / cos_light;
  float sm = pdf_bsdf + pdf_light;
  float wgt = sm > 0.0 ? pdf_bsdf / sm : 1.0;
  return throughput * le * wgt;
}

vec3 direct_lighting(vec3 p, vec3 n, vec3 view, vec3 albedo, float metal, float trans,
                     float rough, int px, int py, int s, int depth) {
  vec3 acc = vec3(0.0);
  vec3 origin = p + n * RAY_EPS;
  int ndir = P.counts2.x;
  int base_dir = dir_off();
  for (int i = 0; i < ndir; i++) {
    vec3 travel = lights[base_dir + i * 2].xyz;
    vec3 le = lights[base_dir + i * 2 + 1].xyz;
    vec3 ldir = normalize(-travel);
    bool blocked = any_hit(origin, ldir, 1e30);
    acc = direct_one(acc, n, view, albedo, metal, trans, rough, ldir, le, 1.0, blocked ? 0.0 : 1.0, 1.0);
  }
  int npt = P.counts2.y;
  int base_pt = pt_off();
  for (int i = 0; i < npt; i++) {
    vec4 a = lights[base_pt + i * 2];
    vec4 b = lights[base_pt + i * 2 + 1];
    vec3 pos = a.xyz;
    float distance = a.w;
    vec3 le = b.xyz;
    float decay = b.w;
    vec3 to_l = pos - p;
    float dist = length(to_l);
    if (dist == 0.0) continue;
    vec3 ldir = to_l / dist;
    float atten;
    if (decay == 2.0) atten = 1.0 / max(dist * dist, 1e-6);
    else atten = 1.0 / max(pow(dist, decay), 1e-6);
    if (distance > 0.0 && dist >= distance) atten = 0.0;
    bool blocked = any_hit(origin, ldir, dist - RAY_EPS);
    acc = direct_one(acc, n, view, albedo, metal, trans, rough, ldir, le, atten, blocked ? 0.0 : 1.0, 1.0);
  }
  int base = depth * 16;
  int nrect = P.counts2.z;
  int base_r = rect_off();
  for (int k = 0; k < nrect; k++) {
    int o = base_r + k * 6;
    vec4 r0 = lights[o + 0], r1 = lights[o + 1], r2 = lights[o + 2], r3 = lights[o + 3];
    vec4 lewh = lights[o + 4];
    float width = lewh.w;
    float height = lights[o + 5].x;
    vec3 le = lewh.xyz;
    float area = width * height;
    if (area <= 0.0) continue;
    float u = rand01(px, py, s, base + 2 + 2 * k);
    float v = rand01(px, py, s, base + 3 + 2 * k);
    int improved = (P.flags.y == 1 || P.flags.y == 2) ? 1 : 0;
    vec3 sample_pos, ldir;
    float dist, cos_light, pdf_area;
    if (!sample_rect(r0, r1, r2, r3, width, height, p, u, v, improved,
                     sample_pos, ldir, dist, cos_light, pdf_area)) continue;
    if (!(pdf_area > 0.0)) continue;
    float dist2 = dist * dist;
    float scale = cos_light / (pdf_area * dist2);
    bool blocked = any_hit(origin, ldir, dist - RAY_EPS);
    float mis_d = 1.0;
    int do_mis = (P.flags.y == 1 || (glossy_on() != 0 && metal > 0.0 && rough > 0.0)) ? 1 : 0;
    if (do_mis != 0) {
      float ndotl = dot(n, ldir);
      if (ndotl > 0.0) {
        float pdf_bsdf = (glossy_on() != 0 && metal > 0.0 && rough > 0.0)
          ? ggx_vndf_pdf(n, view, ldir, rough)
          : (ndotl / FARM_PI);
        float pdf_light = pdf_area * dist2 / cos_light;
        float sm = pdf_light + pdf_bsdf;
        if (sm > 0.0) mis_d = pdf_light / sm;
      }
    }
    acc = direct_one(acc, n, view, albedo, metal, trans, rough, ldir, le, scale, blocked ? 0.0 : 1.0, mis_d);
  }
  return acc;
}

vec3 ambient_term(vec3 albedo, float metal, float trans) {
  vec3 acc = vec3(0.0);
  float fac = (1.0 - metal) * (1.0 - trans);
  int namb = P.counts.w;
  for (int i = 0; i < namb; i++) {
    vec4 a = lights[amb_off() + i];
    float s = fac * a.w;
    acc += albedo * a.xyz * s;
  }
  return acc;
}

void camera_ray(int x, int y, int s, out vec3 o, out vec3 d) {
  float jx, jy;
  pixel_jitter(s, jx, jy);
  float px = float(x) + jx, py = float(y) + jy;
  float tan_half = tan((FARM_PI / 180.0) * 0.5 * P.background.w);
  float ndc_x = (px / float(P.size.x)) * 2.0 - 1.0;
  float ndc_y = 1.0 - (py / float(P.size.y)) * 2.0;
  float cx = ndc_x * P.cam_pos.w * tan_half;
  float cy = ndc_y * tan_half;
  o = P.cam_pos.xyz;
  d = normalize(P.cam_x.xyz * cx + P.cam_y.xyz * cy + P.cam_z.xyz * (-1.0));
}

vec3 trace_radiance(int x, int y, int s) {
  vec3 o, d;
  camera_ray(x, y, s, o, d);
  vec3 throughput = vec3(1.0);
  vec3 acc = vec3(0.0);
  int ambient_done = 0;
  int prev_delta = 1;
  int prev_glossy_bsdf = 0;
  float mis_pdf = 0.0;
  int maxb = P.counts.x;
  for (int depth = 0; depth <= maxb; depth++) {
    if (P.flags.x != 0 && depth >= 3 && prev_delta == 0) {
      float q = max(throughput.x, max(throughput.y, throughput.z));
      q = clamp(q, 0.05, 0.95);
      float ru = rand01(x, y, s, depth * 16 + 15);
      if (ru >= q) break;
      throughput /= q;
    }
    Hit hit = closest_hit(o, d);
    float tcap = hit.hit ? hit.t : 1e30;
    if (mis_pdf > 0.0 && prev_glossy_bsdf != 0)
      acc += mis_rects_along(o, d, tcap, mis_pdf, throughput);
    if (!hit.hit) {
      acc += throughput * P.background.xyz;
      break;
    }
    GpuTri tr = tris[hit.tri_i];
    vec3 a = tr.v0.xyz, b = tr.v1.xyz, c = tr.v2.xyz;
    float wuv = 1.0 - hit.u - hit.v;
    vec3 p = wuv * a + hit.u * b + hit.v * c;
    vec3 ng = normalize(cross(b - a, c - a));
    int mat_id = hit.mat_id;
    vec4 color = mats[mat_id * 4 + 0];
    if (color.w < 0.5) {
      acc += throughput * color.xyz;
      break;
    }
    vec4 pbr = mats[mat_id * 4 + 1];
    vec4 emitv = mats[mat_id * 4 + 2];
    int entering = 1;
    vec3 n = ng;
    if (dot(ng, d) > 0.0) { n = -ng; entering = 0; }
    vec3 view = -d;
    float ndotv = max(dot(n, view), 0.0);
    vec3 albedo = albedo_at(mat_id, tr, hit.u, hit.v);
    float metal = clamp01(pbr.y);
    float rough = clamp01(pbr.x);
    float trans = clamp01(pbr.z);
    if (metal > 0.0) trans = 0.0;
    vec3 emit = emitv.xyz * emitv.w;
    acc += throughput * emit;
    if (rough > 0.0 && ambient_done == 0) {
      acc += throughput * ambient_term(albedo, metal, trans);
      ambient_done = 1;
    }
    if (rough > 0.0) {
      acc += throughput * direct_lighting(p, n, view, albedo, metal, trans, rough, x, y, s, depth);
    }
    if (depth == maxb) break;
    int base = depth * 16;
    if (rough == 0.0 && trans > 0.0) {
      float eta_i, eta_t;
      if (entering == 1) { eta_i = 1.0; eta_t = pbr.w; }
      else { eta_i = pbr.w; eta_t = 1.0; }
      float fr = fresnel_dielectric(ndotv, eta_i, eta_t);
      float xi = rand01(x, y, s, base + 0);
      if (fr >= 1.0 || xi < fr) {
        d = reflect_dir(d, n);
        o = p + n * RAY_EPS;
      } else {
        vec3 rd;
        if (!refract_dir(d, n, eta_i / eta_t, ndotv, rd)) {
          d = reflect_dir(d, n);
          o = p + n * RAY_EPS;
        } else {
          throughput *= albedo;
          d = rd;
          o = p + n * (-RAY_EPS);
        }
      }
      prev_delta = 1;
      mis_pdf = 0.0;
      prev_glossy_bsdf = 0;
    } else if (rough == 0.0) {
      throughput *= schlick(f0_of(albedo, metal), ndotv);
      d = reflect_dir(d, n);
      o = p + n * RAY_EPS;
      prev_delta = 1;
      mis_pdf = 0.0;
      prev_glossy_bsdf = 0;
    } else if (glossy_on() != 0 && metal > 0.0) {
      vec3 tv, bv;
      onb(n, tv, bv);
      vec3 Ve = vec3(dot(view, tv), dot(view, bv), dot(view, n));
      if (Ve.z < NDOT_EPS) Ve.z = NDOT_EPS;
      Ve = normalize(Ve);
      float alpha = rough * rough;
      if (alpha < 1e-4) alpha = 1e-4;
      float u1 = rand01(x, y, s, base + 0);
      float u2 = rand01(x, y, s, base + 1);
      vec3 H = sample_vndf_ggx(Ve, alpha, u1, u2);
      float vdh = dot(Ve, H);
      vec3 Le = 2.0 * vdh * H - Ve;
      if (Le.z <= NDOT_EPS) {
        u1 = rand01(x, y, s, base + 4);
        u2 = rand01(x, y, s, base + 5);
        H = sample_vndf_ggx(Ve, alpha, u1, u2);
        vdh = dot(Ve, H);
        Le = 2.0 * vdh * H - Ve;
      }
      if (Le.z <= NDOT_EPS) {
        d = reflect_dir(d, n);
        throughput *= schlick(f0_of(albedo, metal), ndotv);
        o = p + n * RAY_EPS;
        prev_delta = 1;
        mis_pdf = 0.0;
        prev_glossy_bsdf = 0;
      } else {
        d = normalize(tv * Le.x + bv * Le.y + n * Le.z);
        vec3 F = schlick(f0_of(albedo, metal), max(vdh, 0.0));
        float G1l = smith_g1(Le.z, alpha);
        throughput *= F * G1l;
        o = p + n * RAY_EPS;
        mis_pdf = ggx_vndf_pdf(n, view, d, rough);
        prev_delta = 0;
        prev_glossy_bsdf = 1;
      }
    } else {
      float u1 = rand01(x, y, s, base + 0);
      float u2 = rand01(x, y, s, base + 1);
      vec3 local = cosine_sample(u1, u2);
      vec3 tv, bv;
      onb(n, tv, bv);
      d = normalize(tv * local.x + bv * local.y + n * local.z);
      vec3 fv = schlick(f0_of(albedo, metal), ndotv);
      vec3 weight = (vec3(1.0) - fv) * (1.0 - metal) * (1.0 - trans) * albedo;
      throughput *= weight;
      o = p + n * RAY_EPS;
      prev_delta = 0;
      mis_pdf = 0.0;
      prev_glossy_bsdf = 0;
    }
    if (throughput.x == 0.0 && throughput.y == 0.0 && throughput.z == 0.0) break;
  }
  return acc;
}

void main() {
  int x = int(gl_GlobalInvocationID.x);
  int y = int(gl_GlobalInvocationID.y);
  int W = P.size.x, H = P.size.y;
  if (x >= W || y >= H) return;
  int samples = P.size.z;
  int start_s = P.size.w;
  vec3 sum = vec3(0.0);
  float mean = 0.0, m2 = 0.0;
  int k = 0;
  for (int s = 0; s < samples; s++) {
    vec3 L = trace_radiance(x, y, start_s + s);
    sum += L;
    k++;
    if (P.flags.z != 0) {
      float Y = 0.2126 * L.x + 0.7152 * L.y + 0.0722 * L.z;
      float delta = Y - mean;
      mean += delta / float(k);
      m2 += delta * (Y - mean);
      if (k >= 4 && (m2 / float(k)) < P.extra.x) break;
    }
  }
  int i = (y * W + x) * 3;
  accum[i + 0] = sum.x;
  accum[i + 1] = sum.y;
  accum[i + 2] = sum.z;
}

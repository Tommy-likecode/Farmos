import { Vector3, Matrix4 } from "farmos:math";

function main(): int {
  let v: Vector3 = new Vector3(1.0, 2.0, 3.0);
  let m: Matrix4 = new Matrix4();
  m.identity();
  let i: int = 0;
  for (i = 0; i < 10000; i = i + 1) {
    v.add(new Vector3(0.001, 0.0, 0.0));
    v.applyMatrix4(m);
  }
  println(v.x);
  return 0;
}

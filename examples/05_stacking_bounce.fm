import { World, RigidBody, BODY_DYNAMIC, BODY_STATIC, SphereCollider, PlaneCollider } from "farmos:physics";
import { Scene, Mesh, SphereGeometry, MeshBasicMaterial } from "farmos:scene";

function main(): int {
  const scene: Scene = new Scene();
  const world: World = new World();

  const floor: RigidBody = new RigidBody(BODY_STATIC);
  floor.setRestitution(0.0);
  floor.setFriction(0.5);
  floor.setCollider(new PlaneCollider());
  world.add(floor);

  const mesh0: Mesh = new Mesh(new SphereGeometry(0.5, 8, 4), new MeshBasicMaterial(0xff8866));
  mesh0.position.set(0.0, 0.5, 0.0);
  scene.add(mesh0);
  const b0: RigidBody = new RigidBody(BODY_DYNAMIC);
  b0.setMass(1.0);
  b0.setRestitution(0.0);
  b0.setFriction(0.5);
  b0.setCollider(new SphereCollider(0.5));
  b0.setObject(mesh0);
  world.add(b0);

  const mesh1: Mesh = new Mesh(new SphereGeometry(0.5, 8, 4), new MeshBasicMaterial(0x66ccff));
  mesh1.position.set(0.0, 1.52, 0.0);
  scene.add(mesh1);
  const b1: RigidBody = new RigidBody(BODY_DYNAMIC);
  b1.setMass(1.0);
  b1.setRestitution(0.0);
  b1.setFriction(0.5);
  b1.setCollider(new SphereCollider(0.5));
  b1.setObject(mesh1);
  world.add(b1);

  const bounceMesh: Mesh = new Mesh(new SphereGeometry(0.5, 8, 4), new MeshBasicMaterial(0x88ff88));
  bounceMesh.position.set(1.5, 2.0, 0.0);
  scene.add(bounceMesh);
  const bounce: RigidBody = new RigidBody(BODY_DYNAMIC);
  bounce.setMass(1.0);
  bounce.setRestitution(0.5);
  bounce.setFriction(0.0);
  bounce.setCollider(new SphereCollider(0.5));
  bounce.setObject(bounceMesh);
  world.add(bounce);

  let i: int = 0;
  while (i < 120) {
    world.step();
    i = i + 1;
  }
  println(mesh0.position.y);
  println(mesh1.position.y);
  println(bounceMesh.position.y);
  return 0;
}

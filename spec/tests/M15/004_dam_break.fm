import { LiquidWorld, HeightField } from "farmos:liquid";

function main(): int {
  const world: LiquidWorld = new LiquidWorld();
  const field: HeightField = new HeightField(8, 8, 0.1, 0.1);
  let j: int = 0;
  while (j < 8) {
    let i: int = 0;
    while (i < 8) {
      if (i < 4) {
        field.setHeight(i, j, 1.0);
      } else {
        field.setHeight(i, j, 0.2);
      }
      i = i + 1;
    }
    j = j + 1;
  }
  world.addHeightField(field);
  let n: int = 0;
  while (n < 10) {
    world.step();
    n = n + 1;
  }
  println(field.getHeight(0, 0));
  println(field.getHeight(3, 0));
  println(field.getHeight(7, 0));
  println(field.getHeight(0, 3));
  println(field.getHeight(3, 3));
  println(field.getHeight(7, 3));
  println(field.getHeight(0, 7));
  println(field.getHeight(3, 7));
  println(field.getHeight(7, 7));
  return 0;
}

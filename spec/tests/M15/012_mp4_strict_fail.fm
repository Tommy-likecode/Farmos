import { Scene, PerspectiveCamera, Renderer } from "farmos:scene";
import { Color } from "farmos:math";

function main(): int {
  const scene: Scene = new Scene();
  scene.setBackground(new Color(0x4488ff));
  const camera: PerspectiveCamera = new PerspectiveCamera(60, 16.0 / 9.0, 0.1, 100);
  camera.position.z = 4;
  const renderer: Renderer = new Renderer(640, 360);
  renderer.render(scene, camera);
  renderer.saveMP4("strict_fail.mp4");
  return 0;
}

import { Vector3 } from "farmos:math";

function main(): int {
  let u: Vector3 = new Vector3(1.0, 2.0, 3.0);
  let w: Vector3 = new Vector3(1.0, 2.0, 3.0);
  parallel {
    task {
      u.add(new Vector3(1.0, 1.0, 1.0));
    }
    task {
      w.multiplyScalar(2.0);
    }
  }
  println(u);
  println(w);
  return 0;
}

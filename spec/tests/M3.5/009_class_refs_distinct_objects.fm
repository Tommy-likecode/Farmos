class Counter {
  n: int;

  constructor(n: int) {
    this.n = n;
  }

  inc(): void {
    this.n = this.n + 1;
  }

  get(): int {
    return this.n;
  }
}

function bump(c: Counter, times: int): void {
  for (let i = 0; i < times; i += 1) {
    c.inc();
  }
}

function main(): int {
  const a: Counter = new Counter(0);
  const b: Counter = new Counter(100);
  parallel {
    task {
      bump(a, 5);
    }
    task {
      bump(b, 7);
    }
  }
  println(a.get());
  println(b.get());
  return 0;
}

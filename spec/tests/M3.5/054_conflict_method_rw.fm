class Counter {
  n: int;

  constructor(n: int) {
    this.n = n;
  }

  inc(): void {
    this.n = this.n + 1;
  }

  get(): int {
    return this.n;
  }
}

function main(): int {
  const c: Counter = new Counter(0);
  parallel {
    task {
      c.inc();
    }
    task {
      println(c.get());
    }
  }
  return 0;
}

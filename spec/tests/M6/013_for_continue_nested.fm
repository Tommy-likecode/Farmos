function main(): int {
  let outer: int = 0;
  let inner: int = 0;
  let hits: int = 0;
  let i: int = 0;
  let j: int = 0;
  for (i = 0; i < 3; i = i + 1) {
    outer = outer + 1;
    for (j = 0; j < 3; j = j + 1) {
      if (j == 1) {
        continue;
      }
      hits = hits + 1;
    }
    inner = inner + j;
  }
  println(outer);
  println(inner);
  println(hits);
  println(i);
  return 0;
}

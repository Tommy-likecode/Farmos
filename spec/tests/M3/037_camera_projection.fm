import { PerspectiveCamera } from "farmos:scene";

function main(): int {
  const cam: PerspectiveCamera = new PerspectiveCamera(90, 1, 1, 2);
  cam.position.set(2, 2, 4);
  cam.lookAt(0, 0, 0);
  cam.updateMatrixWorld(true);
  cam.updateProjectionMatrix();
  let i: int = 0;
  for (i = 0; i < 16; i += 1) {
    println(cam.projectionMatrix.elements[i]);
  }
  for (i = 0; i < 16; i += 1) {
    println(cam.matrixWorldInverse.elements[i]);
  }
  return 0;
}

import { Scene, PerspectiveCamera, Renderer } from "farmos:scene";
import { Color } from "farmos:math";

function main(): int {
  const scene: Scene = new Scene();
  scene.setBackground(new Color(0x4488ff));
  const camera: PerspectiveCamera = new PerspectiveCamera(75, 1.3333333333333333, 0.1, 1000);
  camera.position.z = 5;
  const renderer: Renderer = new Renderer(64, 48);
  renderer.render(scene, camera);
  renderer.savePNG("out.png");
  return 0;
}

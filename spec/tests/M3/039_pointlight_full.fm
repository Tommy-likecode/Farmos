import { Scene, PerspectiveCamera, BoxGeometry, MeshStandardMaterial, Mesh,
         PointLight, Renderer } from "farmos:scene";
import { Color } from "farmos:math";

function main(): int {
  const p: PointLight = new PointLight(new Color(0xffffff), 1.0, 8.0, 1.0);
  println(p.intensity);
  println(p.distance);
  println(p.decay);
  const scene: Scene = new Scene();
  scene.setBackground(new Color(0x000000));
  const camera: PerspectiveCamera = new PerspectiveCamera(60, 1, 0.1, 1000);
  camera.position.set(2, 2, 4);
  camera.lookAt(0, 0, 0);
  const cube: Mesh = new Mesh(new BoxGeometry(1, 1, 1), new MeshStandardMaterial(new Color(1, 1, 1)));
  cube.rotation.x = 0.4;
  cube.rotation.y = 0.6;
  scene.add(cube);
  p.position.set(1, 2, 3);
  scene.add(p);
  const renderer: Renderer = new Renderer(128, 128);
  renderer.render(scene, camera);
  renderer.savePNG("out.png");
  return 0;
}

import { Object3D } from "farmos:scene";
import { Quaternion } from "farmos:math";

function main(): int {
  const o: Object3D = new Object3D();
  const q: Quaternion = new Quaternion();
  q.set(0.0, 0.7071067811865475, 0.0, 0.7071067811865476);
  o.setRotationFromQuaternion(q);
  println(o.rotation.x);
  println(o.rotation.y);
  println(o.rotation.z);
  return 0;
}

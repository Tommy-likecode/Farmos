import { Scene, PerspectiveCamera, BoxGeometry, MeshBasicMaterial, Mesh,
         AmbientLight, DirectionalLight, Renderer } from "farmos:scene";
import { Color } from "farmos:math";

function main(): int {
  const scene: Scene = new Scene();
  scene.setBackground(new Color(0x202020));
  const camera: PerspectiveCamera = new PerspectiveCamera(75, 1, 0.1, 1000);
  camera.position.z = 3;
  camera.lookAt(0, 0, 0);
  const cube: Mesh = new Mesh(new BoxGeometry(1, 1, 1), new MeshBasicMaterial(0xff0000));
  scene.add(cube);
  scene.add(new AmbientLight(0xffffff, 1.0));
  scene.add(new DirectionalLight(0xff0000, 1.0));
  const renderer: Renderer = new Renderer(128, 128);
  renderer.render(scene, camera);
  renderer.savePNG("out.png");
  return 0;
}

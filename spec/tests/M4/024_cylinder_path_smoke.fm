import { Scene, PerspectiveCamera, CylinderGeometry, MeshStandardMaterial, Mesh,
         RectAreaLight, Renderer } from "farmos:scene";
import { Color } from "farmos:math";

function main(): int {
  const scene: Scene = new Scene();
  scene.setBackground(new Color(0.2, 0.2, 0.25));
  const camera: PerspectiveCamera = new PerspectiveCamera(40, 1, 0.1, 100);
  camera.position.set(0, 0.6, 3);
  camera.lookAt(0, 0.5, 0);
  const mat: MeshStandardMaterial = new MeshStandardMaterial(new Color(0.7, 0.2, 0.2));
  mat.setRoughness(1);
  const cyl: Mesh = new Mesh(new CylinderGeometry(0.35, 1.0, 16), mat);
  cyl.position.set(0, 0.5, 0);
  scene.add(cyl);
  const light: RectAreaLight = new RectAreaLight(0xffffff, 20, 0.8, 0.8);
  light.position.set(0, 2.2, 0.5);
  light.lookAt(0, 0, 0);
  scene.add(light);
  const renderer: Renderer = new Renderer(8, 8);
  renderer.setSamples(1);
  renderer.setMaxBounces(2);
  renderer.renderPath(scene, camera);
  println(1);
  return 0;
}

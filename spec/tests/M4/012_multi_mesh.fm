import { Scene, PerspectiveCamera, BoxGeometry, SphereGeometry,
         MeshStandardMaterial, Mesh, DirectionalLight, AmbientLight,
         Renderer } from "farmos:scene";
import { Color } from "farmos:math";

function main(): int {
  const scene: Scene = new Scene();
  scene.setBackground(new Color(0x101018));
  const camera: PerspectiveCamera = new PerspectiveCamera(45, 1, 0.1, 100);
  camera.position.set(1.8, 1.4, 2.6);
  camera.lookAt(0, 0.3, 0);
  const aMat: MeshStandardMaterial = new MeshStandardMaterial(new Color(0.85, 0.2, 0.15));
  aMat.setRoughness(0.8);
  const a: Mesh = new Mesh(new BoxGeometry(0.5, 0.5, 0.5), aMat);
  a.position.set(-0.7, 0.25, -0.3);
  scene.add(a);
  const bMat: MeshStandardMaterial = new MeshStandardMaterial(new Color(0.15, 0.45, 0.85));
  bMat.setRoughness(0.8);
  const b: Mesh = new Mesh(new BoxGeometry(0.45, 0.6, 0.45), bMat);
  b.position.set(0.6, 0.3, 0.4);
  scene.add(b);
  const cMat: MeshStandardMaterial = new MeshStandardMaterial(new Color(0.9, 0.75, 0.2));
  cMat.setRoughness(0.8);
  const c: Mesh = new Mesh(new BoxGeometry(0.4, 0.4, 0.7), cMat);
  c.position.set(-0.2, 0.2, 0.7);
  scene.add(c);
  const dMat: MeshStandardMaterial = new MeshStandardMaterial(new Color(0.2, 0.7, 0.35));
  dMat.setRoughness(0.8);
  const d: Mesh = new Mesh(new BoxGeometry(0.55, 0.35, 0.4), dMat);
  d.position.set(0.15, 0.55, -0.6);
  scene.add(d);
  const ballMat: MeshStandardMaterial = new MeshStandardMaterial(new Color(0.9, 0.9, 0.95));
  ballMat.setRoughness(0.3);
  ballMat.setMetalness(0.7);
  const ball: Mesh = new Mesh(new SphereGeometry(0.32, 8, 4), ballMat);
  ball.position.set(0, 0.32, 0);
  scene.add(ball);
  const sun: DirectionalLight = new DirectionalLight(0xffffff, 2);
  sun.lookAt(-0.4, -1, -0.3);
  scene.add(sun);
  scene.add(new AmbientLight(0xffffff, 0.15));
  const renderer: Renderer = new Renderer(24, 24);
  renderer.setSamples(1);
  renderer.setMaxBounces(1);
  renderer.renderPath(scene, camera);
  renderer.savePNG("out.png");
  return 0;
}

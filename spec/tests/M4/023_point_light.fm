import { Scene, PerspectiveCamera, PlaneGeometry, MeshStandardMaterial, Mesh,
         PointLight, Renderer } from "farmos:scene";
import { Color } from "farmos:math";

function main(): int {
  const scene: Scene = new Scene();
  const camera: PerspectiveCamera = new PerspectiveCamera(45, 1, 0.1, 100);
  camera.position.set(1.4, 1.6, 1.8);
  camera.lookAt(0, 0, 0);
  const floorMat: MeshStandardMaterial = new MeshStandardMaterial(new Color(0.85, 0.85, 0.85));
  floorMat.setRoughness(1);
  const floor: Mesh = new Mesh(new PlaneGeometry(3, 3), floorMat);
  floor.quaternion.x = -0.7071067811865476;
  floor.quaternion.y = 0;
  floor.quaternion.z = 0;
  floor.quaternion.w = 0.7071067811865476;
  scene.add(floor);
  const lamp: PointLight = new PointLight(new Color(1, 0.9, 0.7), 6);
  lamp.position.set(0.35, 1.1, 0.25);
  scene.add(lamp);
  const renderer: Renderer = new Renderer(24, 24);
  renderer.setSamples(1);
  renderer.setMaxBounces(0);
  renderer.renderPath(scene, camera);
  renderer.savePNG("out.png");
  return 0;
}

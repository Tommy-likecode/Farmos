import { World, RigidBody, BODY_DYNAMIC, BODY_STATIC, SphereCollider, BoxCollider } from "farmos:physics";
import { Vector3 } from "farmos:math";

function main(): int {
  const world: World = new World();
  world.setGravity(new Vector3(0.0, 0.0, 0.0));
  const box: RigidBody = new RigidBody(BODY_STATIC);
  box.setRestitution(0.0);
  box.setFriction(0.0);
  box.setCollider(new BoxCollider(0.5, 0.5, 0.5));
  world.add(box);
  const ball: RigidBody = new RigidBody(BODY_DYNAMIC);
  ball.setMass(1.0);
  ball.setRestitution(0.0);
  ball.setFriction(0.0);
  ball.setCollider(new SphereCollider(0.5));
  ball.position.set(1.2, 0.0, 0.0);
  ball.linearVelocity.set(-2.0, 0.0, 0.0);
  world.add(ball);
  let i: int = 0;
  while (i < 60) {
    world.step();
    i = i + 1;
  }
  println(ball.position.x);
  println(box.position.x);
  return 0;
}

import { World, RigidBody, BODY_DYNAMIC } from "farmos:physics";

function main(): int {
  const world: World = new World();
  const body: RigidBody = new RigidBody(BODY_DYNAMIC);
  body.setMass(1.0);
  body.position.set(0.0, 5.0, 0.0);
  world.add(body);
  world.step();
  println(body.position.y);
  println(body.linearVelocity.y);
  return 0;
}

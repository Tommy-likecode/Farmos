import { World, RigidBody, BODY_DYNAMIC, SphereCollider } from "farmos:physics";

function main(): int {
  const world: World = new World();
  const a: RigidBody = new RigidBody(BODY_DYNAMIC);
  a.setMass(1.0);
  a.setCollider(new SphereCollider(0.5));
  world.add(a);
  const b: RigidBody = new RigidBody(BODY_DYNAMIC);
  b.setMass(1.0);
  b.setCollider(new SphereCollider(0.5));
  world.add(b);
  world.remove(a);
  println(world.bodyCount());
  world.step();
  println(world.bodyCount());
  return 0;
}

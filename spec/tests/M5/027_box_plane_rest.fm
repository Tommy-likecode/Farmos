import { World, RigidBody, BODY_DYNAMIC, BODY_STATIC, BoxCollider, PlaneCollider } from "farmos:physics";

function main(): int {
  const world: World = new World();
  const floor: RigidBody = new RigidBody(BODY_STATIC);
  floor.setRestitution(0.0);
  floor.setFriction(0.8);
  floor.setCollider(new PlaneCollider());
  world.add(floor);
  const box: RigidBody = new RigidBody(BODY_DYNAMIC);
  box.setMass(1.0);
  box.setRestitution(0.0);
  box.setFriction(0.8);
  box.setCollider(new BoxCollider(0.5, 0.5, 0.5));
  box.position.set(0.0, 0.5, 0.0);
  world.add(box);
  let i: int = 0;
  while (i < 120) {
    world.step();
    i = i + 1;
  }
  println(box.position.y);
  let finite: int = 1;
  if (box.position.y != box.position.y) {
    finite = 0;
  }
  println(finite);
  let above: int = 0;
  if (box.position.y > 0.4) {
    above = 1;
  }
  println(above);
  return 0;
}

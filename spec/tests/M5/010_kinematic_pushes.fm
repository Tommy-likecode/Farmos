import { World, RigidBody, BODY_DYNAMIC, BODY_KINEMATIC, SphereCollider, BoxCollider } from "farmos:physics";
import { Vector3 } from "farmos:math";

function main(): int {
  const world: World = new World();
  world.setGravity(new Vector3(0.0, 0.0, 0.0));
  const pusher: RigidBody = new RigidBody(BODY_KINEMATIC);
  pusher.setRestitution(0.0);
  pusher.setFriction(0.0);
  pusher.setCollider(new BoxCollider(0.5, 0.5, 0.5));
  pusher.position.set(0.0, 0.5, 0.0);
  world.add(pusher);
  const ball: RigidBody = new RigidBody(BODY_DYNAMIC);
  ball.setMass(1.0);
  ball.setRestitution(0.0);
  ball.setFriction(0.0);
  ball.setCollider(new SphereCollider(0.5));
  ball.position.set(1.2, 0.5, 0.0);
  world.add(ball);
  let i: int = 0;
  while (i < 30) {
    pusher.position.x = 0.05 * (i + 1);
    world.step();
    i = i + 1;
  }
  println(pusher.position.x);
  println(ball.position.x);
  return 0;
}

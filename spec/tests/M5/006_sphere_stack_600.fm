import { World, RigidBody, BODY_DYNAMIC, BODY_STATIC, SphereCollider, PlaneCollider } from "farmos:physics";

function main(): int {
  const world: World = new World();
  const floor: RigidBody = new RigidBody(BODY_STATIC);
  floor.setRestitution(0.0);
  floor.setFriction(0.5);
  floor.setCollider(new PlaneCollider());
  world.add(floor);
  const b0: RigidBody = new RigidBody(BODY_DYNAMIC);
  b0.setMass(1.0);
  b0.setRestitution(0.0);
  b0.setFriction(0.5);
  b0.setCollider(new SphereCollider(0.5));
  b0.position.set(0.0, 0.5, 0.0);
  world.add(b0);
  const b1: RigidBody = new RigidBody(BODY_DYNAMIC);
  b1.setMass(1.0);
  b1.setRestitution(0.0);
  b1.setFriction(0.5);
  b1.setCollider(new SphereCollider(0.5));
  b1.position.set(0.0, 1.52, 0.0);
  world.add(b1);
  const b2: RigidBody = new RigidBody(BODY_DYNAMIC);
  b2.setMass(1.0);
  b2.setRestitution(0.0);
  b2.setFriction(0.5);
  b2.setCollider(new SphereCollider(0.5));
  b2.position.set(0.0, 2.54, 0.0);
  world.add(b2);
  const b3: RigidBody = new RigidBody(BODY_DYNAMIC);
  b3.setMass(1.0);
  b3.setRestitution(0.0);
  b3.setFriction(0.5);
  b3.setCollider(new SphereCollider(0.5));
  b3.position.set(0.0, 3.56, 0.0);
  world.add(b3);
  let i: int = 0;
  while (i < 600) {
    world.step();
    i = i + 1;
  }
  println(b0.position.y);
  println(b1.position.y);
  println(b2.position.y);
  println(b3.position.y);
  let ordered: int = 0;
  if (b0.position.y < b1.position.y) {
    if (b1.position.y < b2.position.y) {
      if (b2.position.y < b3.position.y) {
        ordered = 1;
      }
    }
  }
  println(ordered);
  return 0;
}

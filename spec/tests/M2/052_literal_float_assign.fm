import { Vector3 } from "farmos:math";

class Camera {
  position: Vector3;
  constructor() {
    this.position = new Vector3(0.0, 0.0, 0.0);
  }
}

function main(): int {
  let camera: Camera = new Camera();
  // int literal assigned to float field
  camera.position.z = 5;
  camera.position.x = -1;
  println(camera.position);
  return 0;
}

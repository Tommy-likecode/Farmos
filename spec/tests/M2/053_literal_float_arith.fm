import { Vector3 } from "farmos:math";

function main(): int {
  let x: float = 1.5;
  // literal operand in mixed float arith
  let y: float = x * 2;
  let z: float = 4 * x;
  println(y);
  println(z);
  let v: Vector3 = new Vector3(1.0, 0.0, 0.0);
  v.multiplyScalar(3);
  println(v);
  return 0;
}

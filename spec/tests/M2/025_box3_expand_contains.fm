import { Box3, Vector3 } from "farmos:math";

function main(): int {
  let b: Box3 = new Box3();
  b.expandByPoint(new Vector3(1.0, 2.0, 3.0));
  b.expandByPoint(new Vector3(-1.0, 0.0, 5.0));
  println(b.containsPoint(new Vector3(0.0, 1.0, 4.0)));
  println(b.containsPoint(new Vector3(10.0, 0.0, 0.0)));
  println(b.min);
  println(b.max);
  return 0;
}

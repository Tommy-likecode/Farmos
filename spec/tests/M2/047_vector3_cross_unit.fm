import { Vector3 } from "farmos:math";

function main(): int {
  let i: Vector3 = new Vector3(1.0, 0.0, 0.0);
  let j: Vector3 = new Vector3(0.0, 1.0, 0.0);
  let k: Vector3 = new Vector3();
  k.crossVectors(i, j);
  println(k);
  let t: Vector3 = new Vector3();
  t.crossVectors(j, i);
  println(t);
  return 0;
}

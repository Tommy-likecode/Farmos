import { Vector3 } from "farmos:math";

function main(): int {
  let a: Vector3 = new Vector3(1.0, 2.0, 3.0);
  let b: Vector3 = new Vector3(1.0, 2.0, 3.0);
  let c: Vector3 = new Vector3(1.0, 2.0, 4.0);
  println(a.equals(b));
  println(a == b);
  println(a.equals(c));
  println(a != c);
  let z0: Vector3 = new Vector3(0.0, 0.0, 0.0);
  let z1: Vector3 = new Vector3(0.0, 0.0, 0.0);
  z1.x = 0.0 - 0.0;
  println(z0.equals(z1));
  return 0;
}

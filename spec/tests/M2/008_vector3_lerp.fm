import { Vector3 } from "farmos:math";

function main(): int {
  let a: Vector3 = new Vector3(1.0, 1.0, 1.0);
  let b: Vector3 = new Vector3(3.0, 5.0, 7.0);
  let c: Vector3 = a.clone();
  c.lerp(b, 0.0);
  println(c);
  let d: Vector3 = a.clone();
  d.lerp(b, 1.0);
  println(d);
  let e: Vector3 = a.clone();
  e.lerp(b, 0.5);
  println(e);
  return 0;
}

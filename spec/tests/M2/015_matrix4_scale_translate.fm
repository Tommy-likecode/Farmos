import { Matrix4, Vector3 } from "farmos:math";

function main(): int {
  let m: Matrix4 = new Matrix4();
  m.makeScale(2.0, 3.0, 4.0);
  let p: Vector3 = new Vector3(1.0, 1.0, 1.0);
  p.applyMatrix4(m);
  println(p);
  let t: Matrix4 = new Matrix4();
  t.makeTranslation(1.0, 0.0, 0.0);
  let q: Vector3 = new Vector3(1.0, 2.0, 3.0);
  q.applyMatrix4(t);
  println(q);
  return 0;
}
